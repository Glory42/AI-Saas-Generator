# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Local: `docker compose up -d postgres` from the repo root (stand-in for Supabase).
# Production: Supabase → Project Settings → Database → Connection string → Transaction pooler
# (port 6543), with `?sslmode=require` appended, e.g.
# postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://aisg:aisg@localhost:5433/aisg
# Keep small: the Supabase pooler multiplexes connections, and free plans cap clients.
DATABASE_POOL_MAX=5
# Comma-separated allow-list used for CORS and the trusted-origin check on mutations.
CORS_ORIGIN=http://localhost:5173
# Base URL the API is reachable at; used to build URLs for locally stored files.
PUBLIC_API_URL=http://localhost:5000

# --- Auth -------------------------------------------------------------------
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_ACCESS_COOKIE_NAME=aisg_access
AUTH_REFRESH_COOKIE_NAME=aisg_refresh

# --- AI ---------------------------------------------------------------------
# auto = gemini when GEMINI_API_KEY is set, otherwise the free local-preview filter.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_FLASH_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_PRO_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_PROMPT_MODEL=gemini-2.5-flash
# Fallback renderer for the hybrid strategy (Gemini writes the prompt, this draws it). none disables it.
HYBRID_RENDERER=pollinations
# Generations per rolling 24 hours for non-admin users.
GENERATION_DAILY_LIMIT=20

# --- Storage ----------------------------------------------------------------
# auto = cloudinary when all three credentials are set, otherwise local disk.
STORAGE_PROVIDER=auto
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Only used by the local provider; files are served from /api/files/*.
LOCAL_STORAGE_DIR=./storage
